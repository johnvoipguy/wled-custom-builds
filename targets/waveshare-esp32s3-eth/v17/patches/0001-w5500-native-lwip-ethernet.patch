diff --git a/wled00/wled_ethernet.h b/wled00/wled_ethernet.h
index 6b8f0ba..8a1a85c 100644
--- a/wled00/wled_ethernet.h
+++ b/wled00/wled_ethernet.h
@@ -17,6 +17,23 @@
 //              ETH_CLOCK_GPIO0_OUT   == ESP32 provides 50MHz clock output via GPIO0
 //              ETH_CLOCK_GPIO16_OUT  == ESP32 provides 50MHz clock output via GPIO16
 //              ETH_CLOCK_GPIO17_OUT  == ESP32 provides 50MHz clock output via GPIO17
+// SoCs without an internal EMAC (ESP32-S3, S2, C3, ...) never define the RMII clock enum or
+// its constants - they live behind CONFIG_ETH_USE_ESP32_EMAC in the core's ETH.h. The shared
+// ethernet_settings struct below still carries eth_clk_mode, and cfg.cpp still references the
+// ETH_CLOCK_* names, so those targets fail to compile the moment WLED_USE_ETHERNET is enabled.
+// This is why Ethernet has effectively been ESP32-classic-only: it is RMII-shaped throughout.
+// SPI-attached PHYs (W5500) do not use any of it, so provide inert placeholders to let the
+// struct and its consumers compile; nothing reads these values on the SPI path.
+#if !defined(CONFIG_ETH_USE_ESP32_EMAC) || (CONFIG_ETH_USE_ESP32_EMAC == 0)
+  typedef int eth_clock_mode_t;
+  #ifndef ETH_CLOCK_GPIO0_IN
+    #define ETH_CLOCK_GPIO0_IN    0
+    #define ETH_CLOCK_GPIO0_OUT   1
+    #define ETH_CLOCK_GPIO16_OUT  2
+    #define ETH_CLOCK_GPIO17_OUT  3
+  #endif
+#endif
+
 typedef struct EthernetSettings {
   uint8_t        eth_address;
   int            eth_power;
diff --git a/wled00/wled_server.cpp b/wled00/wled_server.cpp
index 7fea738..423bb34 100644
--- a/wled00/wled_server.cpp
+++ b/wled00/wled_server.cpp
@@ -790,6 +790,20 @@ void serveSettings(AsyncWebServerRequest* request, bool post) {
     }
     if (subPage != SUBPAGE_WIFI || !(wifiLock && otaLock)) handleSettingsSet(request, subPage);
 
+    if (subPage == SUBPAGE_LEDS && doInitBusses) {
+      // LED settings defer the actual bus rebuild to loop() via doInitBusses (see set.cpp) -
+      // it isn't safe to run finalizeInit() directly from this request-handler task. Without
+      // this wait, the HTTP response (and any page the browser loads right after) can beat
+      // loop()'s rebuild, so navigating straight back into LED Settings shows the pre-save
+      // config until a manual refresh. Bounded wait (not a busy-deadlock risk: loop() consumes
+      // doInitBusses on its own schedule, independent of this task) so a slow rebuild degrades
+      // to "old data momentarily" instead of "request hangs forever".
+      unsigned long waitStart = millis();
+      while (doInitBusses && millis() - waitStart < 3000) {
+        yield();
+      }
+    }
