+#if defined(WLED_USE_W5500) && defined(ESP_IDF_VERSION) && (ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 0, 0))
+// Deferred W5500 bring-up. Called from WLED::loop(); runs ETH.begin() exactly once, after the
+// Arduino/esp_netif network stack is actually up. See the note in initEthernet() for why this
+// cannot happen during config load on Core 3.x.
+void handleW5500() {
+  if (!w5500Pending || w5500Started) return;
+
+  // Retry until begin() succeeds rather than giving up after one attempt. A single shot means
+  // any transient failure at boot leaves Ethernet dead until a power cycle - unacceptable on a
+  // board that may be bus-powered rather than PoE-cycled.
+  //
+  // Note this retry is only for ETH.begin() itself failing. Link state is NOT a reason to
+  // retry: unlike the 0.15.x hardware-socket driver, this is a real esp_eth/lwIP netif, so
+  // begin() succeeds with no cable attached and the driver raises ETH_CONNECTED / runs DHCP by
+  // itself whenever the link later comes up. That covers slow links - spanning-tree blocking
+  // for ~30s, PoE switch negotiation, cable replugged hours later - with no polling from us.
+  static unsigned long lastAttempt = 0;
+  if (lastAttempt != 0 && millis() - lastAttempt < WLED_W5500_RETRY_MS) return;
+  lastAttempt = millis();
+
+  DEBUG_PRINTLN(F("initW5500: starting deferred ETH.begin()"));
+  if (!ETH.begin(ETH_PHY_W5500, 1 /* phy addr */,
+                 W5500_CS, W5500_INT, W5500_RST, SPI2_HOST,
+                 W5500_SCLK, W5500_MISO, W5500_MOSI, (uint8_t)W5500_SPI_FREQ_MHZ)) {
+    DEBUG_PRINTF_P(PSTR("initW5500: ETH.begin() failed, retrying in %ums\n"), (unsigned)WLED_W5500_RETRY_MS);
+    return; // w5500Started stays false -> retried on a later loop()
+  }
+  w5500Started = true;
+
+  // Only touch ETH.config() when a static IP is actually configured; DHCP is already the
+  // default after a successful begin().
+  //
+  // NOTE the explicit (uint32_t) casts on the IPAddress operands. Writing the comparison the
+  // other way round - "multiWiFi[0].staticIP != (uint32_t)0x00000000", as WLED's RMII path
+  // still does - crashes on Arduino Core 3.x: the compiler treats the zero-valued constant as
+  // a null pointer constant and selects IPAddress::operator==(const uint8_t*), which memcmps
+  // against NULL. That is a hard LoadProhibited fault (memcmp(dest=0, src, 4)) the moment this
+  // line is reached, regardless of whether ETH.config() is ever called.
+  if ((uint32_t)multiWiFi[0].staticIP != 0u && (uint32_t)multiWiFi[0].staticGW != 0u) {
+    ETH.config(multiWiFi[0].staticIP, multiWiFi[0].staticGW, multiWiFi[0].staticSN, dnsAddress);
+  }
+  DEBUG_PRINTLN(F("initW5500: *** W5500 Ethernet started ***"));
+}
