+#ifdef WLED_USE_W5500
+// Waveshare ESP32-S3-ETH: W5500 SPI Ethernet, driven through its own onboard hardware
+// TCP/IP socket engine (WIZnet Arduino Ethernet library), not through ESP32's native
+// ETH/lwIP path. AsyncTCP is hardwired to lwIP and cannot bind to the W5500's separate
+// stack, so WiFi remains the interface for Web UI/WebSockets/JSON API/OTA; the W5500
+// carries realtime UDP LED protocols (E1.31/Art-Net/DDP) and MQTT. See
+// targets/waveshare-esp32s3-eth/v16/notes.md for the full rationale.
+#include <SPI.h>
+#include <Ethernet_Generic.h>
+
+static bool w5500Configured  = false;
+static bool w5500PinsTaken   = false;
+static bool w5500SpiReady    = false;
+
+bool initW5500Ethernet() {
+  if (w5500Configured) return false;
+
+  // Settle delay carried over verbatim from the validated v0.15.1 driver. initEthernet() runs
+  // during boot config load, and the W5500 needs the rail/clock to stabilize before its
+  // registers answer reliably over SPI. Do not remove: without it the chip is not ready when
+  // linkStatus() is first read, which reports Unknown rather than a real link state.
+  delay(100);
+
+  DEBUG_PRINTF_P(PSTR("initW5500: pins MISO:%d MOSI:%d SCLK:%d CS:%d RST:%d INT:%d\n"),
+    W5500_MISO, W5500_MOSI, W5500_SCLK, W5500_CS, W5500_RST, W5500_INT);
+
+  managed_pin_type w5500Pins[6] = {
+    { W5500_CS,   true },  // CS   (output)
+    { W5500_MOSI, true },  // MOSI (output)
+    { W5500_MISO, false }, // MISO (input)
+    { W5500_SCLK, true },  // SCLK (output)
+    { W5500_RST,  true },  // RST  (output)
+    { W5500_INT,  false }, // INT  (input, optional)
+  };
+
+  if (!w5500PinsTaken) {
+    if (!PinManager::allocateMultiplePins(w5500Pins, 6, PinOwner::Ethernet)) {
+      DEBUG_PRINTLN(F("initW5500: failed to allocate SPI pins"));
+      return false;
+    }
+    w5500PinsTaken = true;
+  }
+
+  if (!w5500SpiReady) {
+    pinMode(W5500_RST, OUTPUT);
+    digitalWrite(W5500_RST, LOW);
+    delay(50);
+    digitalWrite(W5500_RST, HIGH);
+    delay(150);
+
+    SPI.begin(W5500_SCLK, W5500_MISO, W5500_MOSI, W5500_CS);
+    SPI.setFrequency(10000000); // 10 MHz - lower speed for stability
+    delay(50);                  // let the SPI bus settle before first chip access (v0.15.1)
+    pinMode(W5500_CS, OUTPUT);
+    digitalWrite(W5500_CS, HIGH);
+    Ethernet.init(W5500_CS);
+    delay(100);
+    w5500SpiReady = true;
+  }
+
+  // Check link status BEFORE Ethernet.begin() so an unplugged cable can't block boot/WiFi.
+  // v0.15.1 tested "== LinkOFF" here; this requires a definitively-up link instead. The two
+  // differ only for Unknown, which linkStatus() returns when the chip does not answer chip-ID
+  // detection - and treating Unknown as "maybe up" falls through to the blocking DHCP call
+  // below. That call runs during boot (initEthernet() is invoked from deserializeConfig()), so
+  // blocking there long enough trips the hardware watchdog; since ethernetType is persisted,
+  // the next boot re-enters the same path - a self-sustaining boot loop (rst:0x7
+  // TG0WDT_SYS_RST) recoverable only by erasing flash. Kept as a deliberate guard, but note
+  // the settle delays above are what actually keep Unknown from occurring in normal operation.
+  if (Ethernet.linkStatus() != LinkON) {
+    DEBUG_PRINTLN(F("initW5500: link not up - will retry via handleW5500() hot-plug polling"));
+    return false; // keep pins/SPI initialized so hot-plug retry can pick up cleanly
+  }
+
+  uint8_t mac[6];
+  uint64_t chipid = ESP.getEfuseMac();
+  mac[0] = 0x02; // locally administered
+  mac[1] = 0x00;
+  mac[2] = (chipid >> 32) & 0xFF;
+  mac[3] = (chipid >> 16) & 0xFF;
+  mac[4] = (chipid >> 8)  & 0xFF;
+  mac[5] =  chipid        & 0xFF;
+
+  // Timeouts carried over verbatim from the validated v0.15.1 driver. This blocks, and
+  // initEthernet() runs during boot config load - but it is only reached once the link is
+  // confirmed up, so it does not run on a disconnected board.
+  if (Ethernet.begin(mac, 15000, 4000) == 0) { // 15s DHCP timeout, 4s per-response timeout
+    DEBUG_PRINTLN(F("initW5500: DHCP timeout"));
+    for (auto& pin : w5500Pins) PinManager::deallocatePin(pin.pin, PinOwner::Ethernet);
+    w5500PinsTaken = false;
+    w5500SpiReady  = false;
+    return false;
+  }
+
+  if (Ethernet.localIP() == INADDR_NONE) {
+    DEBUG_PRINTLN(F("initW5500: no IP address after DHCP"));
+    for (auto& pin : w5500Pins) PinManager::deallocatePin(pin.pin, PinOwner::Ethernet);
+    w5500PinsTaken = false;
+    w5500SpiReady  = false;
+    return false;
+  }
+
+  w5500Configured = true;
+  // Full interface dump, as in v0.15.1 - subnet/gateway/DNS are what you actually need when
+  // diagnosing "got a lease but nothing routes" on this board.
+  DEBUG_PRINTF_P(PSTR("initW5500: *** connected ***\n"));
+  DEBUG_PRINTF_P(PSTR("  IP:      %d.%d.%d.%d\n"),
+    Ethernet.localIP()[0], Ethernet.localIP()[1], Ethernet.localIP()[2], Ethernet.localIP()[3]);
+  DEBUG_PRINTF_P(PSTR("  Subnet:  %d.%d.%d.%d\n"),
+    Ethernet.subnetMask()[0], Ethernet.subnetMask()[1], Ethernet.subnetMask()[2], Ethernet.subnetMask()[3]);
+  DEBUG_PRINTF_P(PSTR("  Gateway: %d.%d.%d.%d\n"),
+    Ethernet.gatewayIP()[0], Ethernet.gatewayIP()[1], Ethernet.gatewayIP()[2], Ethernet.gatewayIP()[3]);
+  DEBUG_PRINTF_P(PSTR("  DNS:     %d.%d.%d.%d\n"),
+    Ethernet.dnsServerIP()[0], Ethernet.dnsServerIP()[1], Ethernet.dnsServerIP()[2], Ethernet.dnsServerIP()[3]);
+  return true;
+}
+
+// Polls the W5500 for hot-plug (cable inserted after boot) and services its DHCP lease.
+// Call once per WLED::loop() iteration; internally rate-limited to every 500ms.
+void handleW5500() {
+  static bool          wasConnected    = false;
+  static unsigned long lastPoll        = 0;
+  static unsigned long lastInitAttempt = 0;
+
+  if (millis() - lastPoll < 500) return;
+  lastPoll = millis();
+
+  if (!w5500Configured) {
+    if (millis() - lastInitAttempt > 5000) {
+      lastInitAttempt = millis();
+      if (w5500SpiReady && Ethernet.linkStatus() == LinkON) {
+        DEBUG_PRINTLN(F("handleW5500: cable detected, retrying init"));
+        initW5500Ethernet();
+      }
+    }
+    return;
+  }
+
+  Ethernet.maintain(); // renew DHCP lease
+
+  bool isConnected = (Ethernet.localIP() != INADDR_NONE && Ethernet.linkStatus() == LinkON);
+  if (isConnected && !wasConnected) {
+    DEBUG_PRINTLN(F("handleW5500: link up"));
+    showWelcomePage = false;
+    wasConnected = true;
+  } else if (!isConnected && wasConnected) {
+    DEBUG_PRINTLN(F("handleW5500: link down"));
+    wasConnected = false;
+    // Deliberately do not touch WiFi here: WiFi's own handleConnection() logic manages
+    // itself independently (see wled.cpp), since it is already the always-on interface.
+  }
+}
+
+// Wrappers consumed by Network.cpp - see the ODR note on these in fcn_declare.h.
+bool w5500IsConnected() { return Ethernet.localIP()[0] != 0; }
+IPAddress w5500LocalIP() { return Ethernet.localIP(); }
+IPAddress w5500SubnetMask() { return Ethernet.subnetMask(); }
+IPAddress w5500GatewayIP() { return Ethernet.gatewayIP(); }
+bool w5500MacAddress(uint8_t* mac) {
+  if (Ethernet.localIP()[0] == 0) return false;
+  Ethernet.MACAddress(mac);
+  for (uint8_t i = 0; i < 6; i++) if (mac[i] != 0x00) return true;
+  return false;
+}
+#endif // WLED_USE_W5500
+
+
